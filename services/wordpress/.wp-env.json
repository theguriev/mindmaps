{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "plugins": ["./plugin/mind-maps"],
  "port": 8879,
  "testsPort": 8880,
  "mappings": {
    "wp-content/mind-maps-service": "."
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": true,
    "SCRIPT_DEBUG": true
  },
  "env": {
    "tests": {
      "plugins": [],
      "mappings": {
        "wp-content/mind-maps-service": "."
      },
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": false
      }
    }
  }
}
