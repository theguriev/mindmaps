{
  "name": "@mindmaps/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canvas mind-map editor engine: custom react-reconciler renderer, domain model, markdown text renderer and the storage-agnostic <MindMapEditor/>.",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/editor/MindMapEditor.tsx",
    "./preview": "./src/mindmap/preview.ts",
    "./logo": "./src/assets/logo.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": ["*.css"],
  "files": ["src"],
  "scripts": {
    "type-check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.23.0",
    "react-reconciler": "^0.33.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@mindmaps/config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-reconciler": "^0.33.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
